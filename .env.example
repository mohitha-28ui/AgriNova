# ==============================================================================
# AgriNova Production Environment Variables
# Single Web Service Deployment on Render + MongoDB Atlas
# ==============================================================================

# MongoDB Atlas Connection URI (Required)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.agrinova.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name (Default: agrinova_db)
DATABASE_NAME=agrinova_db

# JWT Secret Key for Session Authentication (Required in Production)
JWT_SECRET_KEY=agrinova-production-secure-key-change-in-production-2026

# Application Port (Automatically provided by Render at runtime, default: 10000)
PORT=10000

# Optional: Allowed CORS Origins (Comma-separated, default: public wildcard)
# CORS_ALLOWED_ORIGINS=https://agrinova.onrender.com,http://localhost:5173

# Optional: External Big Data Clusters (Only if hosting dedicated external nodes)
# HADOOP_NAMENODE_URL=http://your-hadoop-namenode:9870
# KAFKA_BOOTSTRAP_SERVERS=your-kafka-broker:9092
